# TELEGRAM BOT SETUP
# 1. Go to Telegram, find @BotFather
# 2. Send /newbot and follow instructions
# 3. Copy the bot token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MiniMax Portal API Key
# Get API key from: https://api.minimax.io/
MINIMAX_API_KEY=your_minimax_api_key_here

# ========================================
# OPTIONAL: FIRECRAWL WEB SCRAPING
# ========================================

# Get your Firecrawl API key from https://firecrawl.dev
# This enables advanced web scraping capabilities
# FIRECRAWL_API_KEY=your_firecrawl_api_key_here
# if you set up with api key other wise you can use browser login


# Set thinking level (off, minimal, low, medium, high)
THINKING_LEVEL=high

# Response language
RESPONSE_LANGUAGE=en
